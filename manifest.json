
{
  "manifest_version": 3,
  "name": "PageScope - Webpage Intelligence",
  "version": "1.0.0",
  "description": "Extract, analyze and understand information from any webpage.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Open PageScope"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}
